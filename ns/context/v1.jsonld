{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "cat-harness": "https://litlfred.github.io/cat-harness/v0/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "doco": "http://purl.org/spar/doco/",
    "prov": "http://www.w3.org/ns/prov#",
    "contains": {
      "@id": "dcterms:hasPart",
      "@type": "@id",
      "@container": "@set"
    },
    "derivedFrom": {
      "@id": "prov:wasDerivedFrom",
      "@type": "@id"
    },
    "inSubgraph": {
      "@id": "cat-harness:inSubgraph",
      "@type": "@id"
    },
    "kind": "cat-harness:kind",
    "meta": {
      "@id": "cat-harness:blockMeta",
      "@type": "@json"
    },
    "provenance": "cat-harness:provenance",
    "sourceDocument": {
      "@id": "cat-harness:sourceDocument",
      "@type": "@id"
    },
    "text": {
      "@id": "cat-harness:text"
    },
    "title": "dcterms:title"
  }
}
