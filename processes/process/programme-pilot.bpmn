<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/0.1.0/processes/ns#"
                  id="Definitions_AAI_Pilot" targetNamespace="https://litlfred.github.io/aai-programme/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:resource id="pm-architecture-integration" name="PM &amp; Architecture Integration"/>
  <bpmn:resource id="who-github-owner" name="WHO GitHub owner"/>
  <bpmn:resource id="build-agent" name="Build agent"/>
  <bpmn:resource id="technical-integration-lead" name="Technical Integration Lead"/>
  <bpmn:collaboration id="Collaboration_AAI_Pilot">
    <bpmn:participant id="Participant_AAI_Pilot" name="Assured AI programme: the pilot" processRef="Process_AAI_Pilot"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_AAI_Pilot" name="Assured AI programme: the pilot" isExecutable="false">
    <bpmn:documentation>Prove the set-up small before building it big (req:aai-design-principles#DP-08): build the section 12 pilot set from representative Assured AI items, each marked as a pilot, run every pilot test, and stop on the first failure. No artificial dependencies, and no existing operational work moved to test the configuration.</bpmn:documentation>
    <bpmn:extensionElements>
      <cat-harness.processes:policy enforcement="strict"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_AAI_Pilot">
      <bpmn:lane id="Lane_PM" name="PM &amp; Architecture Integration" partitionElementRef="pm-architecture-integration">
        <bpmn:documentation>Owns sequencing, dates, dependencies, evidence and escalation. Does not make technical readiness judgements (req:aai-design-principles#DP-05).</bpmn:documentation>
        <bpmn:flowNodeRef>A_Agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AAI_Pilot</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Owner" name="WHO GitHub owner" partitionElementRef="who-github-owner">
        <bpmn:documentation>Answers the section 3 decisions and makes the organisation-level changes only an owner can make (req:aai-decisions#BD-05, #BD-08).</bpmn:documentation>
        <bpmn:flowNodeRef>A_Account</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Build agent" partitionElementRef="build-agent">
        <bpmn:documentation>Builds what the decisions allow and stops where the requirements say to stop. Never invents users, teams, repositories, dates or field values.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_AAI_Pilot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Set</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Tests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Partner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_StopPilot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TIL" name="Technical Integration Lead" partitionElementRef="technical-integration-lead">
        <bpmn:documentation>Confirms validation with a comment starting `Validation confirmed:` and the evidence (req:aai-design-principles#DP-05, req:aai-automation#AUTO-10).</bpmn:documentation>
        <bpmn:flowNodeRef>A_Confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_AAI_Pilot" name="Steps 2 to 6 done"/>
    <bpmn:task id="A_Account" name="Provide the test partner account">
      <bpmn:documentation>One account with partner-level access, removed after the build (req:aai-decisions#BD-03b).</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Set" name="Create the pilot set, each item marked pilot">
      <bpmn:documentation>One epic; two features in two workstream repositories as its sub-issues, one blocked by the other; a D-number, a decision, a research question and a milestone; one item with Review type set; one `thin-slice` and one `sprint-demo` item; one issue linking to an external partner repository.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Tests" name="Run the pilot tests">
      <bpmn:documentation>PIL-01, PIL-02, PIL-03, PIL-05, PIL-06 and PIL-08 to PIL-11 (req:aai-pilot), each recorded with its result.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Partner" name="Run PIL-07 as the test partner">
      <bpmn:documentation>Set Integration readiness to Validated on a pilot item with no confirmation comment; AUTO-10 must add `validation-exception` and one comment, and nothing more when run again (req:aai-pilot#PIL-07).</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Confirm" name="Confirm validation on the pilot item">
      <bpmn:documentation>Post `Validation confirmed:` with the evidence, so AUTO-10 removes the label (req:aai-automation#AUTO-10).</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Passed" name="Every test passed?">
      <bpmn:documentation>Answered by the recorded results: does every pilot test pass?</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_StopPilot" name="Stopped: report the failure">
      <bpmn:documentation>Stop and report which test failed and why. Nothing is bulk-imported.</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:task id="A_Report" name="Report the results on the programme issue">
      <bpmn:documentation>One line per pilot test with its result and evidence.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Agree" name="Agree to the bulk import">
      <bpmn:documentation>The PM accepts the results before step 8 starts.</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_AAI_Pilot" name="Ready for the bulk import"/>
    <bpmn:sequenceFlow id="SF_AAI_Pilot_1" sourceRef="Start_AAI_Pilot" targetRef="A_Account"/>
    <bpmn:sequenceFlow id="SF_AAI_Pilot_2" sourceRef="A_Account" targetRef="A_Set"/>
    <bpmn:sequenceFlow id="SF_AAI_Pilot_3" sourceRef="A_Set" targetRef="A_Tests"/>
    <bpmn:sequenceFlow id="SF_AAI_Pilot_4" sourceRef="A_Tests" targetRef="A_Partner"/>
    <bpmn:sequenceFlow id="SF_AAI_Pilot_5" sourceRef="A_Partner" targetRef="A_Confirm"/>
    <bpmn:sequenceFlow id="SF_AAI_Pilot_6" sourceRef="A_Confirm" targetRef="GW_Passed"/>
    <bpmn:sequenceFlow id="SF_AAI_Pilot_7" name="no" sourceRef="GW_Passed" targetRef="End_StopPilot"/>
    <bpmn:sequenceFlow id="SF_AAI_Pilot_8" name="yes" sourceRef="GW_Passed" targetRef="A_Report"/>
    <bpmn:sequenceFlow id="SF_AAI_Pilot_9" sourceRef="A_Report" targetRef="A_Agree"/>
    <bpmn:sequenceFlow id="SF_AAI_Pilot_10" sourceRef="A_Agree" targetRef="End_AAI_Pilot"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_AAI_Pilot">
    <bpmndi:BPMNPlane id="Plane_AAI_Pilot" bpmnElement="Collaboration_AAI_Pilot">
      <bpmndi:BPMNShape id="Shape_Participant_AAI_Pilot" bpmnElement="Participant_AAI_Pilot" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1660" height="680" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_PM_AAI_Pilot" bpmnElement="Lane_PM" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1630" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Owner_AAI_Pilot" bpmnElement="Lane_Owner" isHorizontal="true">
        <dc:Bounds x="190" y="250" width="1630" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Agent_AAI_Pilot" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="1630" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_TIL_AAI_Pilot" bpmnElement="Lane_TIL" isHorizontal="true">
        <dc:Bounds x="190" y="590" width="1630" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_AAI_Pilot_AAI_Pilot" bpmnElement="Start_AAI_Pilot">
        <dc:Bounds x="302" y="487" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Account_AAI_Pilot" bpmnElement="A_Account">
        <dc:Bounds x="410" y="295" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Set_AAI_Pilot" bpmnElement="A_Set">
        <dc:Bounds x="560" y="465" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Tests_AAI_Pilot" bpmnElement="A_Tests">
        <dc:Bounds x="710" y="465" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Partner_AAI_Pilot" bpmnElement="A_Partner">
        <dc:Bounds x="860" y="465" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Confirm_AAI_Pilot" bpmnElement="A_Confirm">
        <dc:Bounds x="1010" y="635" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Passed_AAI_Pilot" bpmnElement="GW_Passed" isMarkerVisible="true">
        <dc:Bounds x="1195" y="480" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_StopPilot_AAI_Pilot" bpmnElement="End_StopPilot">
        <dc:Bounds x="1292" y="542" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Report_AAI_Pilot" bpmnElement="A_Report">
        <dc:Bounds x="1310" y="465" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Agree_AAI_Pilot" bpmnElement="A_Agree">
        <dc:Bounds x="1460" y="125" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_AAI_Pilot_AAI_Pilot" bpmnElement="End_AAI_Pilot">
        <dc:Bounds x="1652" y="147" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_SF_AAI_Pilot_1" bpmnElement="SF_AAI_Pilot_1">
        <di:waypoint x="338" y="505" />
        <di:waypoint x="374" y="505" />
        <di:waypoint x="374" y="335" />
        <di:waypoint x="410" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AAI_Pilot_2" bpmnElement="SF_AAI_Pilot_2">
        <di:waypoint x="530" y="335" />
        <di:waypoint x="545" y="335" />
        <di:waypoint x="545" y="505" />
        <di:waypoint x="560" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AAI_Pilot_3" bpmnElement="SF_AAI_Pilot_3">
        <di:waypoint x="680" y="505" />
        <di:waypoint x="710" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AAI_Pilot_4" bpmnElement="SF_AAI_Pilot_4">
        <di:waypoint x="830" y="505" />
        <di:waypoint x="860" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AAI_Pilot_5" bpmnElement="SF_AAI_Pilot_5">
        <di:waypoint x="980" y="505" />
        <di:waypoint x="995" y="505" />
        <di:waypoint x="995" y="675" />
        <di:waypoint x="1010" y="675" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AAI_Pilot_6" bpmnElement="SF_AAI_Pilot_6">
        <di:waypoint x="1130" y="675" />
        <di:waypoint x="1162" y="675" />
        <di:waypoint x="1162" y="505" />
        <di:waypoint x="1195" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AAI_Pilot_7" bpmnElement="SF_AAI_Pilot_7">
        <di:waypoint x="1245" y="505" />
        <di:waypoint x="1268" y="505" />
        <di:waypoint x="1268" y="560" />
        <di:waypoint x="1292" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AAI_Pilot_8" bpmnElement="SF_AAI_Pilot_8">
        <di:waypoint x="1245" y="505" />
        <di:waypoint x="1310" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AAI_Pilot_9" bpmnElement="SF_AAI_Pilot_9">
        <di:waypoint x="1430" y="505" />
        <di:waypoint x="1445" y="505" />
        <di:waypoint x="1445" y="165" />
        <di:waypoint x="1460" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AAI_Pilot_10" bpmnElement="SF_AAI_Pilot_10">
        <di:waypoint x="1580" y="165" />
        <di:waypoint x="1652" y="165" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
