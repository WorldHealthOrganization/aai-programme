<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/0.1.0/processes/ns#"
                  id="Definitions_AAI_Build" targetNamespace="https://litlfred.github.io/aai-programme/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:resource id="pm-architecture-integration" name="PM &amp; Architecture Integration"/>
  <bpmn:resource id="who-github-owner" name="WHO GitHub owner"/>
  <bpmn:resource id="build-agent" name="Build agent"/>
  <bpmn:resource id="technical-integration-lead" name="Technical Integration Lead"/>
  <bpmn:collaboration id="Collaboration_AAI_Build">
    <bpmn:participant id="Participant_AAI_Build" name="Assured AI programme: build the GitHub set-up" processRef="Process_AAI_Build"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_AAI_Build" name="Assured AI programme: build the GitHub set-up" isExecutable="false">
    <bpmn:documentation>Build the shared programme project, its repositories and automations in the order section 13 of the programme requirements sets, stopping wherever a decision, a credential or a pilot test is missing. Nothing past pre-flight is created until the decisions for that step are confirmed, and nothing is bulk-imported until every pilot test passes.</bpmn:documentation>
    <bpmn:extensionElements>
      <cat-harness.processes:policy enforcement="strict"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_AAI_Build">
      <bpmn:lane id="Lane_PM" name="PM &amp; Architecture Integration" partitionElementRef="pm-architecture-integration">
        <bpmn:documentation>Owns sequencing, dates, dependencies, evidence and escalation, and supplies the section 14 inputs. Does not make technical readiness judgements (DP-05).</bpmn:documentation>
        <bpmn:flowNodeRef>Start_AAI_Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Inputs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AAI_Build</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Owner" name="WHO GitHub owner" partitionElementRef="who-github-owner">
        <bpmn:documentation>Answers the section 3 decisions and runs organisation-level changes only an owner can make: issue types, issue fields and credentials (BD-05, BD-08).</bpmn:documentation>
        <bpmn:flowNodeRef>A_Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_OrgSetup</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Build agent" partitionElementRef="build-agent">
        <bpmn:documentation>Builds what the decisions allow and stops where the requirements say to stop. Never invents users, teams, repositories, dates or field values (section 14).</bpmn:documentation>
        <bpmn:flowNodeRef>A_Preflight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Decided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Repos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Projects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Readmes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Creds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_StopCreds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Automations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Pilot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Pilot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_StopPilot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Charts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TIL" name="Technical Integration Lead" partitionElementRef="technical-integration-lead">
        <bpmn:documentation>Confirms validation with a comment starting `Validation confirmed:` (DP-05, AUTO-10). Automation never sets Validated.</bpmn:documentation>
        <bpmn:flowNodeRef>A_Validate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_AAI_Build" name="Build requested"/>
    <bpmn:task id="A_Preflight" name="Step 1: pre-flight">
      <bpmn:documentation>Inspect the organisation read-only: issue types, issue fields and headroom, project field counts, projects, teams, repository policies, SSO or EMU, and permissions. Reuse compatible configuration; create nothing that duplicates it (section 13 step 1).</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Decided" name="Decisions for the next step confirmed?">
      <bpmn:documentation>Answered from the section 3 decision record: is every decision that step 2 onward depends on confirmed? `no` sends the open ones to the owner; nothing past pre-flight is built until they are.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_Decide" name="Answer the open BD decisions">
      <bpmn:documentation>BD-01a, BD-03a, BD-03b, BD-05, BD-06 and BD-08, each with its recommended default unless the owner says otherwise. The answers are recorded on the programme issue.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_OrgSetup" name="Step 2: create or reuse issue types and fields">
      <bpmn:documentation>Create or reuse the section 5.1 issue types (`AAI` prefix where new) and the section 7.1 issue fields, and pin them as section 5.3 says. If issue fields cannot be used, apply the section 7.4 fallback and record it.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Repos" name="Step 3: repositories, roles and labels">
      <bpmn:documentation>Create `aai-programme`, `aai-pm` and the two workstream repositories the pilot needs, with the BD-04 roles and the section 7.3 labels. A workstream repository is created only once its lead is confirmed.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Projects" name="Step 4: programme project and template">
      <bpmn:documentation>Create the programme project with views V1 to V13 in the listed order, and the workstream template from section 8.3.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Readmes" name="Step 5: READMEs and directory">
      <bpmn:documentation>Write the READMEs (AC-10, AUTO-07, LINK-02, LINK-03, LINK-07) and create the pinned Workstream directory issue (LINK-01).</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Creds" name="Automation credentials in place?">
      <bpmn:documentation>Answered by whether the BD-08 credentials exist as an organisation secret. `no` stops and reports exactly which permission is needed (AUTO-09); the agent never creates credentials itself.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_StopCreds" name="Stopped: credentials needed">
      <bpmn:documentation>The build stops before step 6 and reports the permission it needs.</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:task id="A_Automations" name="Step 6: automations AUTO-01 to AUTO-11">
      <bpmn:documentation>Set up the automations. Every script reruns safely and has `--dry-run` (AUTO-08). None sets readiness, review status, risk category, impact, a decision or risk acceptance (AUTO-05).</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Pilot" name="Step 7: pilot build">
      <bpmn:documentation>Build the section 12 pilot set from representative Assured AI items, each marked as a pilot, and run PIL-01 to PIL-11.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Validate" name="Confirm validation on the pilot item">
      <bpmn:documentation>For PIL-07: post `Validation confirmed:` with the evidence on the pilot item, so AUTO-10 removes the `validation-exception` label.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Pilot" name="Every pilot test passed?">
      <bpmn:documentation>Answered by the PIL-01 to PIL-11 results. `no` stops the build and reports the failure; there is no bulk import after a failed pilot.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_StopPilot" name="Stopped: a pilot test failed">
      <bpmn:documentation>The build stops and reports which pilot test failed.</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:task id="A_Inputs" name="Provide the section 14 inputs">
      <bpmn:documentation>The epics CSV reviewed by each lead, the Gates output list, R1 to R7, the dependency register with restricted content removed, the directory details, and the needed GitHub usernames.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Import" name="Step 8: bulk import and backfill">
      <bpmn:documentation>Import the inputs, leaving missing values empty and listing them, then run the AUTO-11 backfill.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Charts" name="Step 9: charts and acceptance checks">
      <bpmn:documentation>Build charts M1 to M5, or record which cannot be built natively, and check AC-01 to AC-19.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="A_Report" name="Step 10: build report">
      <bpmn:documentation>Hand back the section 16 report.</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_AAI_Build" name="Build report handed back"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_1" sourceRef="Start_AAI_Build" targetRef="A_Preflight"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_2" sourceRef="A_Preflight" targetRef="GW_Decided"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_3" name="no" sourceRef="GW_Decided" targetRef="A_Decide"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_4" sourceRef="A_Decide" targetRef="A_Preflight"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_5" name="yes" sourceRef="GW_Decided" targetRef="A_OrgSetup"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_6" sourceRef="A_OrgSetup" targetRef="A_Repos"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_7" sourceRef="A_Repos" targetRef="A_Projects"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_8" sourceRef="A_Projects" targetRef="A_Readmes"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_9" sourceRef="A_Readmes" targetRef="GW_Creds"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_10" name="no" sourceRef="GW_Creds" targetRef="End_StopCreds"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_11" name="yes" sourceRef="GW_Creds" targetRef="A_Automations"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_12" sourceRef="A_Automations" targetRef="A_Pilot"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_13" sourceRef="A_Pilot" targetRef="A_Validate"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_14" sourceRef="A_Validate" targetRef="GW_Pilot"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_15" name="no" sourceRef="GW_Pilot" targetRef="End_StopPilot"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_16" name="yes" sourceRef="GW_Pilot" targetRef="A_Inputs"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_17" sourceRef="A_Inputs" targetRef="A_Import"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_18" sourceRef="A_Import" targetRef="A_Charts"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_19" sourceRef="A_Charts" targetRef="A_Report"/>
    <bpmn:sequenceFlow id="SF_AAI_Build_20" sourceRef="A_Report" targetRef="End_AAI_Build"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_AAI_Build">
